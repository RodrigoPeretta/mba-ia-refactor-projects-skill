# Chave da aplicação (assina os tokens de login). Sem valor → chave aleatória por boot, com aviso.
SECRET_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas/destrutivas. Sem valor → 403.
ADMIN_TOKEN=
DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URL=sqlite:///tasks.db
# Origens permitidas para CORS, separadas por vírgula (vazio → CORS desativado)
CORS_ORIGINS=
LOG_LEVEL=INFO
# SMTP do serviço de notificação (vazio → envio de e-mail desativado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
