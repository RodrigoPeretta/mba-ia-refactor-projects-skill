# Chave usada para assinar os tokens de sessão. Vazia → chave aleatória a cada boot.
SECRET_KEY=
# Libera operações administrativas via header X-Admin-Token. Vazio → só usuários admin.
ADMIN_TOKEN=
# Validade do token de sessão emitido no /login, em segundos.
SESSION_TOKEN_MAX_AGE=3600
DEBUG=false
HOST=127.0.0.1
PORT=5000
# Flask-SQLAlchemy grava sqlite:///tasks.db em instance/tasks.db
DATABASE_URL=sqlite:///tasks.db
# Origens permitidas no CORS, separadas por vírgula. Vazio → nenhuma.
CORS_ORIGINS=
# Notificações por e-mail. Vazias → envio desativado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
