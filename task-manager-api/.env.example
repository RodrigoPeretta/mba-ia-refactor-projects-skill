# Copie para .env e preencha. Nenhuma variável é obrigatória em desenvolvimento.

# Chave que assina os tokens de sessão. Vazia → chave aleatória a cada boot (com aviso no log).
SECRET_KEY=
# Validade do token de sessão emitido pelo POST /login, em segundos.
SESSION_TOKEN_MAX_AGE=3600
# Token de operador enviado no header X-Admin-Token. Vazio → rotas administrativas fechadas (403).
ADMIN_TOKEN=

DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///tasks.db
# Origens permitidas para CORS, separadas por vírgula. Vazio → CORS desativado.
CORS_ORIGINS=

# E-mail de notificações. Usuário/senha vazios → envio desativado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
