# Bind do servidor
HOST=127.0.0.1
PORT=3000

# Caminho do banco SQLite (":memory:" = em memória, recriado e semeado a cada boot)
DB_PATH=:memory:

# Token exigido no header X-Admin-Token para GET /api/admin/financial-report e DELETE /api/users/:id.
# Vazio = rotas administrativas fechadas (403).
ADMIN_TOKEN=

# Chave do gateway de pagamento (nunca versionar o valor real)
PAYMENT_GATEWAY_KEY=
