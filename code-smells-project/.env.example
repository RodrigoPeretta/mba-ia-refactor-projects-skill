# Copie para o ambiente (ou exporte) antes de rodar `python app.py`. Não versione valores reais.

# Chave da aplicação Flask. Vazia → chave aleatória gerada no boot (com aviso no log).
SECRET_KEY=
# Token exigido no header X-Admin-Token pelas rotas /admin/*. Vazio → rotas /admin respondem 403.
ADMIN_TOKEN=
# Modo debug/reloader do Flask (true/false).
DEBUG=false
# Bind do servidor.
HOST=127.0.0.1
PORT=5000
# Caminho do arquivo SQLite.
DB_PATH=loja.db
# Origens permitidas pelo CORS, separadas por vírgula ("*" = qualquer origem, comportamento original).
CORS_ORIGINS=*
# Valor informado no campo "ambiente" do /health.
APP_ENV=producao
